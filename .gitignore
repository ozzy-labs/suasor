# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*~

# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build
dist/
build/

# Logs
*.log

# Suasor: local data — never commit the private memory store (ADR-0003)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.suasor/

# Coverage
coverage/

# Agent worktrees (isolated; tracked via git worktree metadata, never as a gitlink)
.claude/worktrees/

# Skills: the agent host dirs hold only *local install output* — the assistant
# mirrors written by `suasor skills install` from the docs/skills SSOT, and the
# ecosystem dev skills, which moved to user-scope install (`npx @ozzylabs/skills
# install`) when ADR-0035's project-scope vendoring was partially retracted
# (2026-07-04). Nothing under these dirs is committed, so ignore them whole:
# the previous per-skill negation allowlist re-included directories that no
# longer exist in git at all.
.claude/skills/
.agents/skills/

# Archived agent WIP patches (local-only; never part of a change)
.claude/wip-archive/
